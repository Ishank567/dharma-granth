{
  "id": "niralamba",
  "title": "Niralamba Upanishad",
  "titleSanskrit": "निरालम्ब उपनिषद्",
  "category": "upanishad",
  "source": {
    "repo": "https://sanskritdocuments.org/doc_upanishhat/niralamba.itx",
    "license": "Sanskrit mūla — public domain. Digitized by sanskritdocuments.org.",
    "fetchedAt": "2026-06-03T13:44:40.057Z"
  },
  "totalVerses": 108,
  "totalChapters": 1,
  "chapters": [
    {
      "number": 1,
      "title": "Full Text",
      "titleSanskrit": "सम्पूर्ण पाठ",
      "verses": [
        {
          "number": 3,
          "sanskrit": "यत्रालम्बालम्बिभावो विद्यते न कदाचन ।",
          "transliteration": "yatrAlambAlambibhAvo vidyate na kadAchana .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 4,
          "sanskrit": "ज्ञविज्ञसम्यग्ज्ञालम्बं निरालम्बं हरिं भजे ॥",
          "transliteration": "j~navij~nasamyagj~nAlamba.n nirAlamba.n hariM bhaje ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 5,
          "sanskrit": "ॐ पूर्णमदः पूर्णमिदं पूर्णात्पूर्णमुदच्यते ।",
          "transliteration": "OM pUrNamadaH pUrNamidaM pUrNAtpUrNamudachyate .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 6,
          "sanskrit": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते ॥",
          "transliteration": "pUrNasya pUrNamAdAya pUrNamevAvashiShyate ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 7,
          "sanskrit": "ॐ शान्तिः शान्तिः शान्तिः ॥",
          "transliteration": "OM shAntiH shAntiH shAntiH ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 8,
          "sanskrit": "ॐ नमः शिवाय गुरवे सच्चिदानन्द मूर्तये ।",
          "transliteration": "OM namaH shivAya gurave sachchidAnanda mUrtaye .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 9,
          "sanskrit": "निष्प्रपञ्चाय शान्ताय निरालम्बाय तेजसे ॥",
          "transliteration": "niShprapa~nchAya shAntAya nirAlambAya tejase ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 10,
          "sanskrit": "निरालम्बं समाश्रित्य सालम्बं विजहाति यः ।",
          "transliteration": "nirAlamba.n samAshritya sAlamba.n vijahAti yaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 11,
          "sanskrit": "स संन्यासी च योगी च कैवल्यं पदमश्नुते ।",
          "transliteration": "sa sa.nnyAsI cha yogI cha kaivalya.n padamashnute .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 12,
          "sanskrit": "एषमज्ञानजन्तूनां समस्तारिष्टशान्तये ।",
          "transliteration": "eShamaj~nAnajantUnA.n samastAriShTashAntaye .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 13,
          "sanskrit": "यद्यद्बोद्धव्यमखिलं तदाशङ्क्य ब्रवीम्यहम् ॥",
          "transliteration": "yadyadboddhavyamakhila.n tadAsha~Nkya bravImyaham.h ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 14,
          "sanskrit": "किं ब्रह्म । क ईश्वरः । को जीवः । का प्रकृतिः ।",
          "transliteration": "kiM brahma . ka IshvaraH . ko jIvaH . kA prakR^itiH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 15,
          "sanskrit": "कः परमात्मा । को ब्रह्मा । को विष्णुः । को रुद्रः ।",
          "transliteration": "kaH paramAtmA . ko brahmA . ko viShNuH . ko rudraH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 16,
          "sanskrit": "क इन्द्रः । कः शमनः । कः सूर्यः । कश्चन्द्रः ।",
          "transliteration": "ka indraH . kaH shamanaH . kaH sUryaH . kashchandraH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 17,
          "sanskrit": "के सुराः । के असुराः । के पिशाचाः । के मनुष्याः ।",
          "transliteration": "ke surAH . ke asurAH . ke pishAchAH . ke manuShyAH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 18,
          "sanskrit": "काः स्त्रियः । के पश्वादयः । किं स्थावरम् ।",
          "transliteration": "kAH striyaH . ke pashvAdayaH . ki.n sthAvaram.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 19,
          "sanskrit": "के ब्राह्मणादयः । का जातिः । किं कर्म । किमकर्म ।",
          "transliteration": "ke brAhmaNAdayaH . kA jAtiH . ki.n karma . kimakarma .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 20,
          "sanskrit": "किं ज्ञानम् । किमज्ञानम् । किं सुखम् । किं दुःखम् ।",
          "transliteration": "ki.n j~nAnam.h . kimaj~nAnam.h . ki.n sukham.h . ki.n duHkham.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 21,
          "sanskrit": "कः स्वर्गः । को नरकः । को बन्धः । को मोक्षः ।",
          "transliteration": "kaH svargaH . ko narakaH . ko bandhaH . ko mokShaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 22,
          "sanskrit": "क उपास्यः । कः शिष्यः । को विद्वान् । को मूढः ।",
          "transliteration": "ka upAsyaH . kaH shiShyaH . ko vidvAn.h . ko mUDhaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 23,
          "sanskrit": "किमासुरम् । किं तपः । किं परमं पदम् ।",
          "transliteration": "kimAsuram.h . ki.n tapaH . kiM paramaM padam.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 24,
          "sanskrit": "किं ग्राह्यम् । किमग्राह्यम् । कः संन्यासीत्याहशङ्क्याह",
          "transliteration": "ki.n grAhyam.h . kimagrAhyam.h . kaH sa.nnyAsItyAhasha~NkyAha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 25,
          "sanskrit": "ब्रह्मेति । स होवाच महदहङ्कारपृथिव्यप्तेजोवाय्वाकाशत्वेन",
          "transliteration": "brahmeti . sa hovAcha mahadaha~NkArapR^ithivyaptejovAyvAkAshatvena",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 26,
          "sanskrit": "बृहद्रूपेणाण्डकोशेन कर्मज्ञानार्थरूपतया",
          "transliteration": "bR^ihadrUpeNANDakoshena karmaj~nAnArtharUpatayA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 27,
          "sanskrit": "भासमानमद्वितीयमखिलोपाधिविनिर्मुक्तं",
          "transliteration": "bhAsamAnamadvitIyamakhilopAdhivinirmukta.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 28,
          "sanskrit": "तत्सकलशक्त्युपबृंहितमनाद्यनन्तं",
          "transliteration": "tatsakalashaktyupabR^i.nhitamanAdyananta.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 29,
          "sanskrit": "शुद्धं शिवं शान्तं निर्गुणमित्यादि-",
          "transliteration": "shuddha.n shiva.n shAnta.n nirguNamityAdi\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 30,
          "sanskrit": "वाच्यमनिर्वाच्यं चैतन्यं ब्रह्म ॥ ईश्वर इति च ॥",
          "transliteration": "vAchyamanirvAchya.n chaitanyaM brahma .. Ishvara iti cha ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 31,
          "sanskrit": "ब्रह्मैव स्वशक्तिं प्रकृत्यभिधेयामाश्रित्य",
          "transliteration": "brahmaiva svashaktiM prakR^ityabhidheyAmAshritya",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 32,
          "sanskrit": "लोकान्सृष्ट्वा प्रविश्यान्तर्यामित्वेन ब्रह्मादीनां",
          "transliteration": "lokAnsR^iShTvA pravishyAntaryAmitvena brahmAdInAM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 33,
          "sanskrit": "बुद्धीन्द्रियनियन्तृत्वादीश्वरः ॥ जीव इति च",
          "transliteration": "buddhIndriyaniyantR^itvAdIshvaraH .. jIva iti cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 34,
          "sanskrit": "ब्रह्मविष्ण्वीशानेन्द्रादीनां नामरूपद्वारा",
          "transliteration": "brahmaviShNvIshAnendrAdInA.n nAmarUpadvArA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 35,
          "sanskrit": "स्थूलोऽहमिति मिथ्याध्यासवशाज्जीवः ।सोऽहमेकोऽपि",
          "transliteration": "sthUlo.ahamiti mithyAdhyAsavashAjjIvaH .so.ahameko.api",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 36,
          "sanskrit": "देहारम्भकभेदवशाद्बहुजीवः । प्रकृतिरिति च",
          "transliteration": "dehArambhakabhedavashAdbahujIvaH . prakR^itiriti cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 37,
          "sanskrit": "ब्रह्मणः सकाशान्नानाविचित्रजगन्निर्माण-",
          "transliteration": "brahmaNaH sakAshAnnAnAvichitrajagannirmANa\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 38,
          "sanskrit": "सामार्थ्यबुद्धिरूपा ब्रह्मशक्तिरेव प्रकृतिः ।",
          "transliteration": "sAmArthyabuddhirUpA brahmashaktireva prakR^itiH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 39,
          "sanskrit": "परमात्मेति च देहादेः परतरत्वद्ब्राह्मैव परमात्मा",
          "transliteration": "paramAtmeti cha dehAdeH parataratvadbrAhmaiva paramAtmA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 40,
          "sanskrit": "स ब्रह्मा स विष्णुः स इन्द्रः स शमनः स सूर्यः",
          "transliteration": "sa brahmA sa viShNuH sa indraH sa shamanaH sa sUryaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 41,
          "sanskrit": "स चन्द्रस्ते सुरास्ते असुरास्ते पिशाचास्ते मनुष्यास्ताः",
          "transliteration": "sa chandraste surAste asurAste pishAchAste manuShyAstAH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 42,
          "sanskrit": "स्त्रियस्ते पश्वादयस्तत्स्थावरं ते ब्राह्मणादयः ।",
          "transliteration": "striyaste pashvAdayastatsthAvara.n te brAhmaNAdayaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 43,
          "sanskrit": "सर्वं खल्विदं ब्रह्म नेह नानास्ति किञ्चन । जातिरिति च ।",
          "transliteration": "sarva.n khalvidaM brahma neha nAnAsti ki~nchana . jAtiriti cha .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 44,
          "sanskrit": "न चर्मणो न रक्तस्य न मांसस्य न चास्थिनः ।",
          "transliteration": "na charmaNo na raktasya na mA.nsasya na chAsthinaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 45,
          "sanskrit": "न जातिरात्मनो जातिर्व्यवहारप्रकल्पिता । कर्मेति च",
          "transliteration": "na jAtirAtmano jAtirvyavahAraprakalpitA . karmeti cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 46,
          "sanskrit": "क्रियमाणेन्द्रियैः कर्मण्यहं करोमीत्यध्यात्मनिष्ठतया",
          "transliteration": "kriyamANendriyaiH karmaNyaha.n karomItyadhyAtmaniShThatayA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 47,
          "sanskrit": "कृतं कर्मैव कर्म । अकर्मेति च कर्तृत्वभोक्तृत्वा-",
          "transliteration": "kR^ita.n karmaiva karma . akarmeti cha kartR^itvabhoktR^itvA\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 48,
          "sanskrit": "द्यहङ्कारतया बन्धरूपं जन्मादिकारणं",
          "transliteration": "dyaha~NkAratayA bandharUpa.n janmAdikAraNa.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 49,
          "sanskrit": "नित्यनैमित्तिकयागव्रततपोदानादिषु फलाभिसन्धानं",
          "transliteration": "nityanaimittikayAgavratatapodAnAdiShu phalAbhisandhAna.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 50,
          "sanskrit": "यत्तदकर्म ।",
          "transliteration": "yattadakarma .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 51,
          "sanskrit": "ज्ञानमिति च देहेन्द्रियनिग्रहसद्गुरूपासन-",
          "transliteration": "j~nAnamiti cha dehendriyanigrahasadgurUpAsana\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 52,
          "sanskrit": "श्रवणमनननिदिध्यासनैर्यद्यदृग्दृश्यस्वरूपं",
          "transliteration": "shravaNamanananididhyAsanairyadyadR^igdR^ishyasvarUpa.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 53,
          "sanskrit": "सर्वान्तरस्थं सर्वसमं घटपटादिपदार्थ-",
          "transliteration": "sarvAntarastha.n sarvasama.n ghaTapaTAdipadArtha\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 54,
          "sanskrit": "मिवाविकारं विकारेषु चैतन्यं विना किञ्चिन्नास्तीति",
          "transliteration": "mivAvikAra.n vikAreShu chaitanya.n vinA ki~nchinnAstIti",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 55,
          "sanskrit": "साक्षात्कारानुभवो ज्ञानम् । अज्ञानमिति च",
          "transliteration": "sAkShAtkArAnubhavo j~nAnam.h . aj~nAnamiti cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 56,
          "sanskrit": "रज्जौ सर्पभ्रान्तिरिवाद्वितीये सर्वानुस्यूते सर्वमये",
          "transliteration": "rajjau sarpabhrAntirivAdvitIye sarvAnusyUte sarvamaye",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 57,
          "sanskrit": "ब्रह्मणि देवतिर्यङ्नरस्थावरस्त्रीपुरुषवर्णाश्रम-",
          "transliteration": "brahmaNi devatirya~NnarasthAvarastrIpuruShavarNAshrama\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 58,
          "sanskrit": "बन्धमोक्षोपाधिनानात्मभेदकल्पित ज्ञानमज्ञानम् ।",
          "transliteration": "bandhamokShopAdhinAnAtmabhedakalpita j~nAnamaj~nAnam.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 59,
          "sanskrit": "सुखमिति च सच्चिदानन्दस्वरूपं ज्ञात्वानन्दरूपा",
          "transliteration": "sukhamiti cha sachchidAnandasvarUpa.n j~nAtvAnandarUpA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 60,
          "sanskrit": "या स्थितिः सैव सुखम् । दुःखमिति अनात्मरूपः",
          "transliteration": "yA sthitiH saiva sukham.h . duHkhamiti anAtmarUpaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 61,
          "sanskrit": "विषयसङ्कल्प एव दुःखम् । स्वर्ग इति च सत्संसर्गः",
          "transliteration": "viShayasa~Nkalpa eva duHkham.h . svarga iti cha satsa.nsargaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 62,
          "sanskrit": "स्वर्गः । नरक इति च असत्संसारविषयजनसंसर्ग एव",
          "transliteration": "svargaH . naraka iti cha asatsa.nsAraviShayajanasa.nsarga eva",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 63,
          "sanskrit": "नरकः । बन्ध इति च अनाद्यविद्यावासनया जातोऽहमि-",
          "transliteration": "narakaH . bandha iti cha anAdyavidyAvAsanayA jAto.ahami\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 64,
          "sanskrit": "त्यादिसङ्कल्पो बन्धः । पितृमातृसहोदरदारापत्य-",
          "transliteration": "tyAdisa~Nkalpo bandhaH . pitR^imAtR^isahodaradArApatya\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 65,
          "sanskrit": "गृहारामक्षेत्रममता संसारावरणसङ्कल्पो बन्धः ।",
          "transliteration": "gR^ihArAmakShetramamatA sa.nsArAvaraNasa~Nkalpo bandhaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 66,
          "sanskrit": "कर्तृत्वाद्यहङ्कारसङ्कल्पो बन्धः । अणिमाद्यष्टैश्व-",
          "transliteration": "kartR^itvAdyaha~NkArasa~Nkalpo bandhaH . aNimAdyaShTaishva\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 67,
          "sanskrit": "र्याशासिद्धसङ्कल्पो बन्धः । देवमनुष्याद्युपासना-",
          "transliteration": "ryAshAsiddhasa~Nkalpo bandhaH . devamanuShyAdyupAsanA\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 68,
          "sanskrit": "कामसङ्कल्पो बन्धः । यमाद्यष्टाङ्गयोगसङ्कल्पो",
          "transliteration": "kAmasa~Nkalpo bandhaH . yamAdyaShTA~Ngayogasa~Nkalpo",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 69,
          "sanskrit": "बन्धः । वर्णाश्रमधर्मकर्मसङ्कल्पो बन्धः ।",
          "transliteration": "bandhaH . varNAshramadharmakarmasa~Nkalpo bandhaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 70,
          "sanskrit": "आज्ञाभयसंशयात्मगुणसङ्कल्पो बन्धः । यागव्रत-",
          "transliteration": "Aj~nAbhayasa.nshayAtmaguNasa~Nkalpo bandhaH . yAgavrata\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 71,
          "sanskrit": "तपोदानविधिविधानज्ञानसम्भवो बन्धः । केवलमोक्षा-",
          "transliteration": "tapodAnavidhividhAnaj~nAnasambhavo bandhaH . kevalamokShA\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 72,
          "sanskrit": "पेक्षासङ्कल्पो बन्धः । सङ्कल्पमात्रसंभवो बन्धः ।",
          "transliteration": "pekShAsa~Nkalpo bandhaH . sa~NkalpamAtrasaMbhavo bandhaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 73,
          "sanskrit": "मोक्ष इति च नित्यानित्यवस्तुविचारादनित्यसंसारसुख-",
          "transliteration": "mokSha iti cha nityAnityavastuvichArAdanityasa.nsArasukha\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 74,
          "sanskrit": "दुःखविषयसमस्तक्षेत्रममताबन्धक्षयो मोक्षः ।",
          "transliteration": "duHkhaviShayasamastakShetramamatAbandhakShayo mokShaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 75,
          "sanskrit": "उपास्य इति च सर्वशरीरस्थचैतन्यब्रह्मप्रापको गुरुरुपास्यः ।",
          "transliteration": "upAsya iti cha sarvasharIrasthachaitanyabrahmaprApako gururupAsyaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 76,
          "sanskrit": "शिष्य इति च विद्याध्वस्तप्रपञ्चावगाहितज्ञानावशिष्टं",
          "transliteration": "shiShya iti cha vidyAdhvastaprapa~nchAvagAhitaj~nAnAvashiShTaM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 77,
          "sanskrit": "ब्रह्मैव शिष्यः । विद्वानिति च सर्वान्तरस्थस्वसंविद्रूपवि-",
          "transliteration": "brahmaiva shiShyaH . vidvAniti cha sarvAntarasthasvasa.nvidrUpavi\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 78,
          "sanskrit": "द्विद्वान् । मूढ इति च कर्तृत्वाद्यहङ्कारभावारूढो मूढः ।",
          "transliteration": "dvidvAn.h . mUDha iti cha kartR^itvAdyaha~NkArabhAvArUDho mUDhaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 79,
          "sanskrit": "आसुरमिति च ब्रह्मविष्ण्वीशानेन्द्रादीना-",
          "transliteration": "Asuramiti cha brahmaviShNvIshAnendrAdInA\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 80,
          "sanskrit": "मैश्वर्यकामनया निरशनजपाग्निहोत्रादि-",
          "transliteration": "maishvaryakAmanayA nirashanajapAgnihotrAdi\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 81,
          "sanskrit": "ष्वन्तरात्मानं सन्तापयति चात्युग्रराग-",
          "transliteration": "ShvantarAtmAna.n santApayati chAtyugrarAga\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 82,
          "sanskrit": "द्वेषविहिंसा दम्भाद्यपेक्षितं तप आसुरम् ।",
          "transliteration": "dveShavihi.nsA dambhAdyapekShita.n tapa Asuram.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 83,
          "sanskrit": "तप इति च ब्रह्म सत्यं जगन्मिथ्येत्यपरोक्ष-",
          "transliteration": "tapa iti cha brahma satya.n jaganmithyetyaparokSha\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 84,
          "sanskrit": "ज्ञानाग्निना ब्रह्माद्यैश्वर्याशासिद्धसङ्कल्प-",
          "transliteration": "j~nAnAgninA brahmAdyaishvaryAshAsiddhasa~Nkalpa\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 85,
          "sanskrit": "बीजसन्तापं तपः । परमं पदमिति च",
          "transliteration": "bIjasantApa.n tapaH . paramaM padamiti cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 86,
          "sanskrit": "प्राणेन्द्रियाद्यन्तःकरणगुणादेः परतरं",
          "transliteration": "prANendriyAdyantaHkaraNaguNAdeH paratara.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 87,
          "sanskrit": "सच्चिदानन्दमयं नित्यमुक्तब्रह्मस्थानं",
          "transliteration": "sachchidAnandamaya.n nityamuktabrahmasthAnaM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 88,
          "sanskrit": "परमं पदम् । ग्राह्यमिति च देशकालवस्तु-",
          "transliteration": "paramaM padam.h . grAhyamiti cha deshakAlavastu\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 89,
          "sanskrit": "परिच्छेदराहित्यचिन्मात्रस्वरूपं ग्राह्यम् ।",
          "transliteration": "parichChedarAhityachinmAtrasvarUpa.n grAhyam.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 90,
          "sanskrit": "अग्राह्यमिति च स्वस्वरूपव्यतिरिक्तमायामय-",
          "transliteration": "agrAhyamiti cha svasvarUpavyatiriktamAyAmaya\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 91,
          "sanskrit": "बुद्धीन्द्रियगोचरजगत्सत्यत्वचिन्तनमग्राह्यम् ।",
          "transliteration": "buddhIndriyagocharajagatsatyatvachintanamagrAhyam.h .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 92,
          "sanskrit": "संन्यासीति च सर्वधर्मान्परित्यज्य निर्ममो",
          "transliteration": "sa.nnyAsIti cha sarvadharmAnparityajya nirmamo",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 93,
          "sanskrit": "निरहङ्कारो भूत्वा ब्रह्मेष्टं शरणमुपगम्य",
          "transliteration": "niraha~NkAro bhUtvA brahmeShTa.n sharaNamupagamya",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 94,
          "sanskrit": "तत्त्वमसि अहं ब्रह्मास्मि सर्वं खल्विदं ब्रह्म",
          "transliteration": "tattvamasi ahaM brahmAsmi sarva.n khalvidaM brahma",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 95,
          "sanskrit": "नेह नानास्ति किञ्चनेत्यादिमहावाक्यार्था-",
          "transliteration": "neha nAnAsti ki~nchanetyAdimahAvAkyArthA\\-",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 96,
          "sanskrit": "नुभवज्ञानाद्ब्रह्मैवाहमस्मीति निश्चित्य",
          "transliteration": "nubhavaj~nAnAdbrahmaivAhamasmIti nishchitya",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 97,
          "sanskrit": "निर्विकल्पसमाधिना स्वतन्त्रो यतिश्चरति स संन्यासी",
          "transliteration": "nirvikalpasamAdhinA svatantro yatishcharati sa sa.nnyAsI",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 98,
          "sanskrit": "स मुक्तः स पूज्यः स योगी स परमहंसः सोऽवधूतः",
          "transliteration": "sa muktaH sa pUjyaH sa yogI sa paramaha.nsaH so.avadhUtaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 99,
          "sanskrit": "स ब्राह्मण इति । इदं निरालम्बोपनिषदं योऽधीते",
          "transliteration": "sa brAhmaNa iti . ida.n nirAlambopaniShada.n yo.adhIte",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 100,
          "sanskrit": "गुर्वनुग्रहतः सोऽग्निपूतो भवति स वायुपूतो भवति",
          "transliteration": "gurvanugrahataH so.agnipUto bhavati sa vAyupUto bhavati",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 101,
          "sanskrit": "न स पुनरावर्तते न स पुनरावर्तते पुनर्नाभिजायते",
          "transliteration": "na sa punarAvartate na sa punarAvartate punarnAbhijAyate",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 102,
          "sanskrit": "पुनर्नाभिजायत इत्युपनिषत् ॥",
          "transliteration": "punarnAbhijAyata ityupaniShat.h ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 103,
          "sanskrit": "ॐ पूर्णमदः पूर्णमिदं पूर्णात्पूर्णमुदच्यते ।",
          "transliteration": "OM pUrNamadaH pUrNamidaM pUrNAtpUrNamudachyate .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 104,
          "sanskrit": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते ॥",
          "transliteration": "pUrNasya pUrNamAdAya pUrNamevAvashiShyate ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 105,
          "sanskrit": "ॐ शान्तिः शान्तिः शान्तिः ॥",
          "transliteration": "OM shAntiH shAntiH shAntiH ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 106,
          "sanskrit": "इति निरालम्बोपनिषत्समाप्ता ॥",
          "transliteration": "iti nirAlambopaniShatsamAptA ..",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 107,
          "sanskrit": "Eन्चोदेद् ब्य् षुन्देर् ःअत्तन्गदि",
          "transliteration": "Encoded by Sunder Hattangadi",
          "translation": "",
          "hindi": ""
