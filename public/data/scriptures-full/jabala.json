          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 3,
          "sanskrit": "jAbAlopaniShatkhyAta.n sa.nnyAsaj~nAnagocharam |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 4,
          "sanskrit": "vastutastraipadaM brahma svamAtramavashiShyate ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 5,
          "sanskrit": "OM pUrNamadaH pUrNamidaM pUrNAt pUrNamudachyate |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 6,
          "sanskrit": "pUrNasya pUrNamAdAya pUrNamevAvashiShyate ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 7,
          "sanskrit": "OM shAntiH shAntiH shAntiH ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 8,
          "sanskrit": "OM bR^ihaspatiruvAcha yAj~navalkya.n yadanu kurukShetra.n",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 9,
          "sanskrit": "devAnA.n devayajana.n sarveShAM bhUtAnAM brahmasadanam |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 10,
          "sanskrit": "avimukta.n vai kurukShetra.n devAnA.n devayajana.n sarveShAM",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 11,
          "sanskrit": "bhUtAnAM brahmasadanam |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 12,
          "sanskrit": "tasmAdyatra kvachana gachChati tadeva manyeta tadavimuktameva |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 13,
          "sanskrit": "ida.n vai kurukShetra.n devAnA.n devayajana.n sarveShAM",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 14,
          "sanskrit": "bhUtAnAM brahmasadanam ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 15,
          "sanskrit": "atra hi jantoH prANeShUtkramamANeShu rudrastArakaM brahma",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 16,
          "sanskrit": "vyAchaShTe yenAsAvamR^itI bhUtvA mokShI bhavati",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 17,
          "sanskrit": "tasmAdavimuktameva niSheveta avimukta.n na",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 18,
          "sanskrit": "vimu~nchedevamevaitadyAj~navalkyaH || 1||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 19,
          "sanskrit": "atha hainamatriH paprachCha yAj~navalkya.n ya eSho.ananto.avyakta",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 20,
          "sanskrit": "AtmA ta.n kathamaha.n vijAnIyAmiti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 21,
          "sanskrit": "sa hovAcha yAj~navalkyaH so.avimukta upAsyo ya",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 22,
          "sanskrit": "eSho.ananto.avyakta AtmA so.avimukte pratiShThita iti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 23,
          "sanskrit": "so.avimuktaH kasminpratiShThita iti | varaNAyA.n nAshyA.n cha",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 24,
          "sanskrit": "madhye pratiShThita iti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 25,
          "sanskrit": "kA vai varaNA kA cha nAshIti |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 26,
          "sanskrit": "sarvAnindriyakR^itAndoShAnvArayatIti tena varaNA bhavati ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 27,
          "sanskrit": "sarvAnindriyakR^itAnpApAnnAshayatIti tena nAshI bhavatIti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 28,
          "sanskrit": "katama.n chAsya sthAnaM bhavatIti | bhruvorghrANasya cha yaH",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 29,
          "sanskrit": "sandhiH sa eSha dyaurlokasya parasya cha sandhirbhavatIti | etadvai",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 30,
          "sanskrit": "sandhi.n sandhyAM brahmavida upAsata iti | so.avimukta upAsya iti",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 31,
          "sanskrit": ". so.avimukta.n j~nAnamAchaShTe | yo vaitadeva.n vedeti || 2||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 32,
          "sanskrit": "atha hainaM brahmachAriNa UchuH ki.n japyenAmR^itatvaM brUhIti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 33,
          "sanskrit": "sa hovAcha yAj~navalkyaH | shatarudriyeNetyetAnyeva ha vA",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 34,
          "sanskrit": "amR^itasya nAmAni ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 35,
          "sanskrit": "etairha vA amR^ito bhavatIti evamevaitadyAj~navalkyaH || 3||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 36,
          "sanskrit": "atha haina.n janako vaideho yAj~navalkyamupasametyovAcha",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 37,
          "sanskrit": "bhagavansa.nnyAsaM brUhIti | sa hovAcha yAj~navalkyaH .",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 38,
          "sanskrit": "brahmacharyaM parisamApya gR^ihI bhavet | gR^ihI bhUtvA vanI",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 39,
          "sanskrit": "bhavet | vanI bhUtvA pravrajet | yadi vetarathA",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 40,
          "sanskrit": "brahmacharyAdeva pravrajedgR^ihAdvA vanAdvA ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 41,
          "sanskrit": "atha punaravratI vA vratI vA snAtako vA.asnAtako",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 42,
          "sanskrit": "votsannagniko vA yadahareva virajettadahareva pravrajet |",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 43,
          "sanskrit": "taddhaike prAjApatyAmeveShTi,n kurvanti | tadu tathA na",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 44,
          "sanskrit": "kuryAdAgneyImeva kuryAt ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 45,
          "sanskrit": "agnirha vai prANaH prANameva tathA karoti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 46,
          "sanskrit": "traidhAtavIyAmeva kuryAt | etayaiva trayo dhAtavo yaduta",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 47,
          "sanskrit": "sattva.n rajastama iti ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 48,
          "sanskrit": "aya.n te yonirR^itvijo yato jAtaH prANAdarochathAH | taM",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 49,
          "sanskrit": "prANa.n jAnannagna ArohAthA no vardhaya rayim | ityanena",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 50,
          "sanskrit": "mantreNAgnimAjighret ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 51,
          "sanskrit": "eSha ha vA agneryoniryaH prANaH prANa.n gachCha",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 52,
          "sanskrit": "svAhetyevamevaitadAha ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 53,
          "sanskrit": "grAmAdagnimAhR^itya pUrvadagnimAghrApayet ||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 54,
          "sanskrit": "yadyagni.n na vindedapsu juhuyAt | Apo vai sarvA devatAH",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 55,
          "sanskrit": "sarvAbhyo devatAbhyo juhomi svAheti hutvodhR^itya",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 56,
          "sanskrit": "prAshnIyAtsAjya.n haviranAmayaM mokShamantraH trayyaiva.n",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 57,
          "sanskrit": "vadet | etadbrahmaitadupAsitavyam | evamevaitadbhagavanniti vai",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 58,
          "sanskrit": "yAj~navalkyaH || 4||",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 59,
          "sanskrit": "atha hainamatriH paprachCha yAj~navalkyaM pR^ichChAmi tvA",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 60,
          "sanskrit": "yAj~navalkya ayaj~nopavIti kathaM brAhmaNa iti | sa hovAcha",
          "transliteration": "",
          "translation": "",
          "hindi": ""
        },
