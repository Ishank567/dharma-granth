  "chapters": [
    {
      "number": 1,
      "title": "Full Text",
      "titleSanskrit": "सम्पूर्ण पाठ",
      "verses": [
        {
          "number": 3,
          "sanskrit": "जाबालोपनिषत्ख्यातं संन्यासज्ञानगोचरम् ।",
          "transliteration": "jAbAlopaniShatkhyAta.n sa.nnyAsaj~nAnagocharam |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 4,
          "sanskrit": "वस्तुतस्त्रैपदं ब्रह्म स्वमात्रमवशिष्यते ॥",
          "transliteration": "vastutastraipadaM brahma svamAtramavashiShyate ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 5,
          "sanskrit": "ॐ पूर्णमदः पूर्णमिदं पूर्णात् पूर्णमुदच्यते ।",
          "transliteration": "OM pUrNamadaH pUrNamidaM pUrNAt pUrNamudachyate |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 6,
          "sanskrit": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते ॥",
          "transliteration": "pUrNasya pUrNamAdAya pUrNamevAvashiShyate ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 7,
          "sanskrit": "ॐ शान्तिः शान्तिः शान्तिः ॥",
          "transliteration": "OM shAntiH shAntiH shAntiH ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 8,
          "sanskrit": "ॐ बृहस्पतिरुवाच याज्ञवल्क्यं यदनु कुरुक्षेत्रं",
          "transliteration": "OM bR^ihaspatiruvAcha yAj~navalkya.n yadanu kurukShetra.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 9,
          "sanskrit": "देवानां देवयजनं सर्वेषां भूतानां ब्रह्मसदनम् ।",
          "transliteration": "devAnA.n devayajana.n sarveShAM bhUtAnAM brahmasadanam |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 10,
          "sanskrit": "अविमुक्तं वै कुरुक्षेत्रं देवानां देवयजनं सर्वेषां",
          "transliteration": "avimukta.n vai kurukShetra.n devAnA.n devayajana.n sarveShAM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 11,
          "sanskrit": "भूतानां ब्रह्मसदनम् ।",
          "transliteration": "bhUtAnAM brahmasadanam |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 12,
          "sanskrit": "तस्माद्यत्र क्वचन गच्छति तदेव मन्येत तदविमुक्तमेव ।",
          "transliteration": "tasmAdyatra kvachana gachChati tadeva manyeta tadavimuktameva |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 13,
          "sanskrit": "इदं वै कुरुक्षेत्रं देवानां देवयजनं सर्वेषां",
          "transliteration": "ida.n vai kurukShetra.n devAnA.n devayajana.n sarveShAM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 14,
          "sanskrit": "भूतानां ब्रह्मसदनम् ॥",
          "transliteration": "bhUtAnAM brahmasadanam ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 15,
          "sanskrit": "अत्र हि जन्तोः प्राणेषूत्क्रममाणेषु रुद्रस्तारकं ब्रह्म",
          "transliteration": "atra hi jantoH prANeShUtkramamANeShu rudrastArakaM brahma",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 16,
          "sanskrit": "व्याचष्टे येनासावमृती भूत्वा मोक्षी भवति",
          "transliteration": "vyAchaShTe yenAsAvamR^itI bhUtvA mokShI bhavati",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 17,
          "sanskrit": "तस्मादविमुक्तमेव निषेवेत अविमुक्तं न",
          "transliteration": "tasmAdavimuktameva niSheveta avimukta.n na",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 18,
          "sanskrit": "विमुञ्चेदेवमेवैतद्याज्ञवल्क्यः ॥ १॥",
          "transliteration": "vimu~nchedevamevaitadyAj~navalkyaH || 1||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 19,
          "sanskrit": "अथ हैनमत्रिः पप्रच्छ याज्ञवल्क्यं य एषोऽनन्तोऽव्यक्त",
          "transliteration": "atha hainamatriH paprachCha yAj~navalkya.n ya eSho.ananto.avyakta",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 20,
          "sanskrit": "आत्मा तं कथमहं विजानीयामिति ॥",
          "transliteration": "AtmA ta.n kathamaha.n vijAnIyAmiti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 21,
          "sanskrit": "स होवाच याज्ञवल्क्यः सोऽविमुक्त उपास्यो य",
          "transliteration": "sa hovAcha yAj~navalkyaH so.avimukta upAsyo ya",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 22,
          "sanskrit": "एषोऽनन्तोऽव्यक्त आत्मा सोऽविमुक्ते प्रतिष्ठित इति ॥",
          "transliteration": "eSho.ananto.avyakta AtmA so.avimukte pratiShThita iti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 23,
          "sanskrit": "सोऽविमुक्तः कस्मिन्प्रतिष्ठित इति । वरणायां नाश्यां च",
          "transliteration": "so.avimuktaH kasminpratiShThita iti | varaNAyA.n nAshyA.n cha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 24,
          "sanskrit": "मध्ये प्रतिष्ठित इति ॥",
          "transliteration": "madhye pratiShThita iti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 25,
          "sanskrit": "का वै वरणा का च नाशीति ।",
          "transliteration": "kA vai varaNA kA cha nAshIti |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 26,
          "sanskrit": "सर्वानिन्द्रियकृतान्दोषान्वारयतीति तेन वरणा भवति ॥",
          "transliteration": "sarvAnindriyakR^itAndoShAnvArayatIti tena varaNA bhavati ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 27,
          "sanskrit": "सर्वानिन्द्रियकृतान्पापान्नाशयतीति तेन नाशी भवतीति ॥",
          "transliteration": "sarvAnindriyakR^itAnpApAnnAshayatIti tena nAshI bhavatIti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 28,
          "sanskrit": "कतमं चास्य स्थानं भवतीति । भ्रुवोर्घ्राणस्य च यः",
          "transliteration": "katama.n chAsya sthAnaM bhavatIti | bhruvorghrANasya cha yaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 29,
          "sanskrit": "सन्धिः स एष द्यौर्लोकस्य परस्य च सन्धिर्भवतीति । एतद्वै",
          "transliteration": "sandhiH sa eSha dyaurlokasya parasya cha sandhirbhavatIti | etadvai",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 30,
          "sanskrit": "सन्धिं सन्ध्यां ब्रह्मविद उपासत इति । सोऽविमुक्त उपास्य इति",
          "transliteration": "sandhi.n sandhyAM brahmavida upAsata iti | so.avimukta upAsya iti",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 31,
          "sanskrit": "। सोऽविमुक्तं ज्ञानमाचष्टे । यो वैतदेवं वेदेति ॥ २॥",
          "transliteration": ". so.avimukta.n j~nAnamAchaShTe | yo vaitadeva.n vedeti || 2||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 32,
          "sanskrit": "अथ हैनं ब्रह्मचारिण ऊचुः किं जप्येनामृतत्वं ब्रूहीति ॥",
          "transliteration": "atha hainaM brahmachAriNa UchuH ki.n japyenAmR^itatvaM brUhIti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 33,
          "sanskrit": "स होवाच याज्ञवल्क्यः । शतरुद्रियेणेत्येतान्येव ह वा",
          "transliteration": "sa hovAcha yAj~navalkyaH | shatarudriyeNetyetAnyeva ha vA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 34,
          "sanskrit": "अमृतस्य नामानि ॥",
          "transliteration": "amR^itasya nAmAni ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 35,
          "sanskrit": "एतैर्ह वा अमृतो भवतीति एवमेवैतद्याज्ञवल्क्यः ॥ ३॥",
          "transliteration": "etairha vA amR^ito bhavatIti evamevaitadyAj~navalkyaH || 3||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 36,
          "sanskrit": "अथ हैनं जनको वैदेहो याज्ञवल्क्यमुपसमेत्योवाच",
          "transliteration": "atha haina.n janako vaideho yAj~navalkyamupasametyovAcha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 37,
          "sanskrit": "भगवन्संन्यासं ब्रूहीति । स होवाच याज्ञवल्क्यः ।",
          "transliteration": "bhagavansa.nnyAsaM brUhIti | sa hovAcha yAj~navalkyaH .",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 38,
          "sanskrit": "ब्रह्मचर्यं परिसमाप्य गृही भवेत् । गृही भूत्वा वनी",
          "transliteration": "brahmacharyaM parisamApya gR^ihI bhavet | gR^ihI bhUtvA vanI",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 39,
          "sanskrit": "भवेत् । वनी भूत्वा प्रव्रजेत् । यदि वेतरथा",
          "transliteration": "bhavet | vanI bhUtvA pravrajet | yadi vetarathA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 40,
          "sanskrit": "ब्रह्मचर्यादेव प्रव्रजेद्गृहाद्वा वनाद्वा ॥",
          "transliteration": "brahmacharyAdeva pravrajedgR^ihAdvA vanAdvA ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 41,
          "sanskrit": "अथ पुनरव्रती वा व्रती वा स्नातको वाऽस्नातको",
          "transliteration": "atha punaravratI vA vratI vA snAtako vA.asnAtako",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 42,
          "sanskrit": "वोत्सन्नग्निको वा यदहरेव विरजेत्तदहरेव प्रव्रजेत् ।",
          "transliteration": "votsannagniko vA yadahareva virajettadahareva pravrajet |",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 43,
          "sanskrit": "तद्धैके प्राजापत्यामेवेष्टि,न् कुर्वन्ति । तदु तथा न",
          "transliteration": "taddhaike prAjApatyAmeveShTi,n kurvanti | tadu tathA na",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 44,
          "sanskrit": "कुर्यादाग्नेयीमेव कुर्यात् ॥",
          "transliteration": "kuryAdAgneyImeva kuryAt ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 45,
          "sanskrit": "अग्निर्ह वै प्राणः प्राणमेव तथा करोति ॥",
          "transliteration": "agnirha vai prANaH prANameva tathA karoti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 46,
          "sanskrit": "त्रैधातवीयामेव कुर्यात् । एतयैव त्रयो धातवो यदुत",
          "transliteration": "traidhAtavIyAmeva kuryAt | etayaiva trayo dhAtavo yaduta",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 47,
          "sanskrit": "सत्त्वं रजस्तम इति ॥",
          "transliteration": "sattva.n rajastama iti ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 48,
          "sanskrit": "अयं ते योनिरृत्विजो यतो जातः प्राणादरोचथाः । तं",
          "transliteration": "aya.n te yonirR^itvijo yato jAtaH prANAdarochathAH | taM",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 49,
          "sanskrit": "प्राणं जानन्नग्न आरोहाथा नो वर्धय रयिम् । इत्यनेन",
          "transliteration": "prANa.n jAnannagna ArohAthA no vardhaya rayim | ityanena",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 50,
          "sanskrit": "मन्त्रेणाग्निमाजिघ्रेत् ॥",
          "transliteration": "mantreNAgnimAjighret ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 51,
          "sanskrit": "एष ह वा अग्नेर्योनिर्यः प्राणः प्राणं गच्छ",
          "transliteration": "eSha ha vA agneryoniryaH prANaH prANa.n gachCha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 52,
          "sanskrit": "स्वाहेत्येवमेवैतदाह ॥",
          "transliteration": "svAhetyevamevaitadAha ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 53,
          "sanskrit": "ग्रामादग्निमाहृत्य पूर्वदग्निमाघ्रापयेत् ॥",
          "transliteration": "grAmAdagnimAhR^itya pUrvadagnimAghrApayet ||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 54,
          "sanskrit": "यद्यग्निं न विन्देदप्सु जुहुयात् । आपो वै सर्वा देवताः",
          "transliteration": "yadyagni.n na vindedapsu juhuyAt | Apo vai sarvA devatAH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 55,
          "sanskrit": "सर्वाभ्यो देवताभ्यो जुहोमि स्वाहेति हुत्वोधृत्य",
          "transliteration": "sarvAbhyo devatAbhyo juhomi svAheti hutvodhR^itya",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 56,
          "sanskrit": "प्राश्नीयात्साज्यं हविरनामयं मोक्षमन्त्रः त्रय्यैवं",
          "transliteration": "prAshnIyAtsAjya.n haviranAmayaM mokShamantraH trayyaiva.n",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 57,
          "sanskrit": "वदेत् । एतद्ब्रह्मैतदुपासितव्यम् । एवमेवैतद्भगवन्निति वै",
          "transliteration": "vadet | etadbrahmaitadupAsitavyam | evamevaitadbhagavanniti vai",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 58,
          "sanskrit": "याज्ञवल्क्यः ॥ ४॥",
          "transliteration": "yAj~navalkyaH || 4||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 59,
          "sanskrit": "अथ हैनमत्रिः पप्रच्छ याज्ञवल्क्यं पृच्छामि त्वा",
          "transliteration": "atha hainamatriH paprachCha yAj~navalkyaM pR^ichChAmi tvA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 60,
          "sanskrit": "याज्ञवल्क्य अयज्ञोपवीति कथं ब्राह्मण इति । स होवाच",
          "transliteration": "yAj~navalkya ayaj~nopavIti kathaM brAhmaNa iti | sa hovAcha",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 61,
          "sanskrit": "याज्ञवल्क्यः । इदमेवास्य तद्यज्ञोपवीतं य आत्मापः",
          "transliteration": "yAj~navalkyaH | idamevAsya tadyaj~nopavIta.n ya AtmApaH",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 62,
          "sanskrit": "प्राश्याचम्यायं विधिः परिव्राजकानाम् । वीराध्वाने वा",
          "transliteration": "prAshyAchamyAya.n vidhiH parivrAjakAnAm | vIrAdhvAne vA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 63,
          "sanskrit": "अनाशके वा अपां प्रवेशे वा अग्निप्रवेशे वा महाप्रस्थाने वा",
          "transliteration": "anAshake vA apAM praveshe vA agnipraveshe vA mahAprasthAne vA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 64,
          "sanskrit": "। अथ परिव्राड्विवर्णवासा मुण्डोऽपरिग्रहः शुचिरद्रोही",
          "transliteration": ". atha parivrADvivarNavAsA muNDo.aparigrahaH shuchiradrohI",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 65,
          "sanskrit": "भैक्षणो ब्रह्मभूयाय भवतीति । यद्यातुरः स्यान्मनसा",
          "transliteration": "bhaikShaNo brahmabhUyAya bhavatIti | yadyAturaH syAnmanasA",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 66,
          "sanskrit": "वाचा संन्यसेत् । एष पन्था ब्रह्मणा हानुवित्तस्तेनैति",
          "transliteration": "vAchA sa.nnyaset | eSha panthA brahmaNA hAnuvittastenaiti",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 67,
          "sanskrit": "संन्यासी ब्रह्मविदित्येवमेवैष भगवन्याज्ञवल्क्य ॥ ५॥",
          "transliteration": "sa.nnyAsI brahmavidityevamevaiSha bhagavanyAj~navalkya || 5||",
          "translation": "",
          "hindi": ""
        },
        {
          "number": 68,
