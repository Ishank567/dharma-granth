import { ImageResponse } from 'next/og';

export const alt = 'Dharma Granth — verse by verse';
export const size = { width: 1200, height: 630 };
export const contentType = 'image/png';

export function generateStaticParams() {
  return [{ id: 'bhagavadgita' }];
}

export default function ScriptureOg() {
  return new ImageResponse(
    <div style={{ width: '100%', height: '100%', display: 'flex', background: '#9a3412', color: 'white' }}>
      Dharma Granth
    </div>,
    size,
  );
}
